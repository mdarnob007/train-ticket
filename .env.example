# Bangladesh Railway RPA configuration
# Copy to .env and fill in real values. Never commit .env.

# Login credentials (phone-number login)
RAILWAY_USER=
RAILWAY_PASS=
CONTACT_EMAIL=

# Booking defaults
DEFAULT_FROM=Dhaka
DEFAULT_TO=Cox's Bazar
DEFAULT_CLASS=SNIGDHA            # the class/seat category to book (AC_S | S_CHAIR | SNIGDHA | AC_B)
SEAT_CLASSES=AC_S,S_CHAIR,SNIGDHA,AC_B   # allowed classes (drives validation + dropdown)
DEFAULT_NUMBER_OF_PASSENGERS=2 # seats to auto-pick (<= 4)
SEAT_PREFERENCES=24,25,29,28          # optional preferred seat numbers, ranked, e.g. 24,25,29,28; blank = any free
SEAT_COACH=JA                   # optional coach code, e.g. GA; prepended to SEAT_PREFERENCES when set
JOURNEY_DATE=08-Aug-2026                 # journey date dd-MMM-yyyy; leave blank to always enter it on the form
DEFAULT_RELEASE_TIME=08:00
DEFAULT_DATE_FORMAT=%d-%b-%Y

# Directories (absolute or relative to project root)
PROFILE_DIR=profiles/chrome
DATA_DIR=data

# Browser
HEADLESS=false
DRIVER_ENGINE=uc            # uc = undetected-chromedriver (Cloudflare-friendly), selenium = plain
IMPLICIT_WAIT_SECS=5
EXPLICIT_WAIT_SECS=30

# Booking behaviour
MAX_PASSENGERS=4
POLL_INTERVAL_SECS=2
RETRY_DELAY_SECS=2
BACKOFF_MAX_SECS=60
TIMEOUT_MIN=10